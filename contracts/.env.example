# JSON-RPC endpoint for ETH Sepolia (Alchemy/Infura/public node)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of the funded Sepolia deployer account (0x-prefixed).
# NEVER commit the real .env file.
DEPLOYER_PRIVATE_KEY=

# Set after deploying the piggy bank (used by the e2e script)
PIGGYBANK_ADDRESS=
